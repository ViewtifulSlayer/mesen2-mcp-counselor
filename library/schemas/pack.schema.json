{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ViewtifulSlayer/mesen2-mcp-counselor/library/schemas/pack.schema.json",
  "title": "Counselor pack manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "platform",
    "region",
    "packVersion",
    "status",
    "license",
    "skill",
    "coverage",
    "tested",
    "requires",
    "sources",
    "corpus",
    "data",
    "tests"
  ],
  "anyOf": [
    { "required": ["rom"] },
    { "required": ["target"] }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["gb", "gbc", "gba", "nes", "snes", "genesis", "sms", "gg", "pce", "pc", "other"] },
    "region": { "type": "string", "minLength": 2 },
    "packVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["stub", "draft", "verified", "certified"] },
    "license": { "const": "CC-BY-SA-4.0" },
    "rom": {
      "type": "object",
      "required": ["title", "size", "sha1", "mapper"],
      "properties": {
        "title": { "type": "string" },
        "size": { "type": "integer", "minimum": 1 },
        "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mapper": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["kind", "title", "build", "files"],
      "properties": {
        "kind": { "enum": ["rom", "unity", "native", "other"] },
        "title": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 },
        "region": { "type": "string" },
        "language": { "type": "string" },
        "unityVersion": { "type": "string" },
        "scriptingBackend": { "enum": ["mono", "il2cpp", "unknown"] },
        "metadataVersion": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "path", "bytes", "sha256"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "required": ["name", "entry"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "entry": { "const": "SKILL.md" }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["overview", "world", "systems", "data", "harness", "edgeCases", "variants"],
      "properties": {
        "overview": { "$ref": "#/$defs/coverage" },
        "world": { "$ref": "#/$defs/coverage" },
        "systems": { "$ref": "#/$defs/coverage" },
        "data": { "$ref": "#/$defs/coverage" },
        "harness": { "$ref": "#/$defs/coverage" },
        "edgeCases": { "$ref": "#/$defs/coverage" },
        "variants": { "$ref": "#/$defs/coverage" }
      }
    },
    "tested": {
      "type": "object",
      "properties": {
        "mesen2Mcp": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "harness": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "anyOf": [
        { "required": ["mesen2Mcp"] },
        { "required": ["harness"] }
      ]
    },
    "requires": {
      "type": "object",
      "required": ["tools"],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "object",
      "required": ["public", "local"],
      "properties": {
        "public": { "type": "string" },
        "local": { "type": "string" }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["platform", "game"],
      "properties": {
        "platform": { "type": "string" },
        "game": { "type": "string" }
      }
    },
    "data": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lua": {
      "type": "object",
      "required": ["libDir", "recipes"],
      "properties": {
        "libDir": { "type": "string" },
        "recipes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "harness": {
      "type": "object",
      "required": ["kind", "scripts"],
      "properties": {
        "kind": { "enum": ["mesen2-lua", "save-file", "runtime-bridge", "mixed"] },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "recipes": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "tests": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "coverage": { "enum": ["none", "outline", "partial", "verified"] }
  }
}
